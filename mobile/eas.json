{
  "cli": { "version": ">=16.0.0", "appVersionSource": "remote" },
  "build": {
    "local": {
      "distribution": "internal",
      "env": { "APP_VARIANT": "local" },
      "ios": { "buildConfiguration": "Release" },
      "android": { "buildType": "apk" }
    },
    "simulator": { "extends": "local", "ios": { "simulator": true } },
    "internal": {
      "distribution": "internal",
      "autoIncrement": true,
      "env": { "APP_VARIANT": "production" },
      "ios": { "buildConfiguration": "Release" },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease -PreactNativeArchitectures=arm64-v8a",
        "credentialsSource": "local",
        "node": "24.14.1",
        "env": {
          "ASIDE_TEST_API": "0",
          "EXPO_PUBLIC_API_URL": "https://asidefm.com"
        }
      }
    },
    "testflight": {
      "distribution": "store",
      "autoIncrement": true,
      "env": { "APP_VARIANT": "production" },
      "ios": { "buildConfiguration": "Release" }
    }
  },
  "submit": { "testflight": {} }
}
